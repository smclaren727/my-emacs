#!/bin/bash
# Open a bookmark from the running Emacs daemon via emacsclient.
# emacsclient creates the GUI frame, Emacs runs the picker inside it,
# and the helper deletes the frame on exit.
#
# Dynamically resolves the socket path via getconf so this works
# from Shortcuts.app and other sandboxed environments.
#
# Usage: ./bookmark-open
# Wire to Raycast/Alfred/Shortcuts.app for system-wide access.

set -euo pipefail

EMACSCLIENT="/opt/homebrew/bin/emacsclient"
STABLE_SOCKET="$HOME/.emacs.d/var/server/server"
LEGACY_SOCKET="$(getconf DARWIN_USER_TEMP_DIR)emacs$(id -u)/server"
FRAME_PARAMS='((auto-raise . t)
               (fullscreen . nil)
               (height . 18)
               (width . 104)
               (top . 200)
               (left . 0.33)
               (internal-border-width . 14)
               (left-fringe . 0)
               (right-fringe . 0)
               (line-spacing . 2)
               (menu-bar-lines . 0)
               (minibuffer . only)
               (tool-bar-lines . 0)
               (undecorated . t)
               (unsplittable . t)
               (vertical-scroll-bars . nil))'

socket_is_live() {
  local socket="$1"
  [[ -S "$socket" ]] || return 1
  "$EMACSCLIENT" -s "$socket" -e '(emacs-pid)' >/dev/null 2>&1
}

pick_socket() {
  local socket
  for socket in "$STABLE_SOCKET" "$LEGACY_SOCKET"; do
    if socket_is_live "$socket"; then
      printf '%s\n' "$socket"
      return 0
    fi
  done
  return 1
}

if ! SOCKET="$(pick_socket)"; then
  echo "No live Emacs server socket found." >&2
  echo "Restart the Emacs daemon or run M-x server-start, then run this shortcut again." >&2
  exit 1
fi

DAEMON_PID="$("$EMACSCLIENT" -s "$SOCKET" -e '(emacs-pid)' | tr -d '"')"

"$EMACSCLIENT" \
  -s "$SOCKET" \
  -n \
  -c \
  -F "$FRAME_PARAMS" \
  -e '(my-bookmarks-open-frame)' \
  >/dev/null

# Bring the daemon-owned Emacs frame to the foreground.  This is best-effort:
# macOS updates can reset or tighten Automation/Accessibility permissions for
# Shortcuts/Services, and a focus denial should not make the successful picker
# launch look like a failed service.
if ! /usr/bin/osascript \
  -e "tell application \"System Events\" to set frontmost of first process whose unix id is ${DAEMON_PID} to true" \
  >/dev/null 2>&1; then
  :
fi
