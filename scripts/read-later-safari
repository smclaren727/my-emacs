#!/bin/bash
# Capture the front Safari tab into the local read-later store.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TMP_OUTPUT="$(mktemp)"
trap 'rm -f "$TMP_OUTPUT"' EXIT

osascript >"$TMP_OUTPUT" <<'APPLESCRIPT'
tell application "Safari"
  if not (exists front document) then error "Safari has no front document"
  set pageUrl to URL of front document
  set pageTitle to name of front document
  set selectedText to do JavaScript "window.getSelection().toString()" in front document
end tell
return pageUrl & linefeed & pageTitle & linefeed & selectedText
APPLESCRIPT

URL="$(sed -n '1p' "$TMP_OUTPUT")"
TITLE="$(sed -n '2p' "$TMP_OUTPUT")"
SELECTION="$(sed '1,2d' "$TMP_OUTPUT")"

"${SCRIPT_DIR}/read-later-capture" \
  --url "$URL" \
  --title "$TITLE" \
  --source safari \
  --selection "$SELECTION" \
  --archive-mode readable
