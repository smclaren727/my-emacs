#!/bin/bash
# Open a bookmark from the running Emacs daemon via emacsclient.
# emacsclient creates the GUI frame, Emacs runs the picker inside it,
# and the helper deletes the frame on exit.
#
# Dynamically resolves the socket path via getconf so this works
# from Shortcuts.app and other sandboxed environments.
#
# Usage: ./bookmark-open
# Wire to Raycast/Alfred/Shortcuts.app for system-wide access.

set -euo pipefail

EMACSCLIENT="/opt/homebrew/bin/emacsclient"
STABLE_SOCKET="$HOME/.emacs.d/var/server/server"
LEGACY_SOCKET="$(getconf DARWIN_USER_TEMP_DIR)emacs$(id -u)/server"
FRAME_PARAMS='((auto-raise . t)
               (fullscreen . nil)
               (height . 20)
               (width . 110)
               (top . 200)
               (left . 0.33)
               (internal-border-width . 20)
               (left-fringe . 0)
               (right-fringe . 0)
               (line-spacing . 3)
               (menu-bar-lines . 0)
               (minibuffer . only)
               (tool-bar-lines . 0)
               (undecorated . t)
               (unsplittable . t)
               (vertical-scroll-bars . nil))'

if [[ -S "$STABLE_SOCKET" ]]; then
  SOCKET="$STABLE_SOCKET"
elif [[ -S "$LEGACY_SOCKET" ]]; then
  SOCKET="$LEGACY_SOCKET"
else
  echo "No Emacs server socket found." >&2
  echo "Restart the Emacs daemon once so it recreates the socket, then run this shortcut again." >&2
  exit 1
fi

DAEMON_PID="$("$EMACSCLIENT" -s "$SOCKET" -e '(emacs-pid)' | tr -d '"')"

"$EMACSCLIENT" \
  -s "$SOCKET" \
  -n \
  -c \
  -F "$FRAME_PARAMS" \
  -e '(my-bookmarks-open-frame)' \
  >/dev/null

# Bring the daemon-owned Emacs frame to the foreground.
osascript -e "tell application \"System Events\" to set frontmost of first process whose unix id is ${DAEMON_PID} to true"
