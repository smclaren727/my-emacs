#!/usr/bin/env python3
"""Fetch readable/full snapshots for save-link capture items."""

from __future__ import annotations

import argparse
import datetime as dt
import html.parser
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path


USER_AGENT = "Mozilla/5.0 save-link-snapshot/1.0"
READABILITY_PACKAGES = (
    "playwright@1.60.0",
    "@mozilla/readability@0.6.0",
    "jsdom@24.1.3",
)


def iso_timestamp() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def default_root() -> Path:
    root = os.environ.get("MY_SAVE_LINK_ROOT")
    if root:
        return Path(root).expanduser()
    return Path("~/All-The-Things/50-Resources/Save-Link").expanduser()


class TextExtractor(html.parser.HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.parts: list[str] = []
        self.skip_depth = 0

    def handle_starttag(self, tag: str, attrs) -> None:
        if tag in {"script", "style", "noscript"}:
            self.skip_depth += 1
        if tag in {"p", "br", "div", "section", "article", "h1", "h2", "h3", "li"}:
            self.parts.append("\n")

    def handle_endtag(self, tag: str) -> None:
        if tag in {"script", "style", "noscript"} and self.skip_depth:
            self.skip_depth -= 1
        if tag in {"p", "div", "section", "article", "li"}:
            self.parts.append("\n")

    def handle_data(self, data: str) -> None:
        if not self.skip_depth:
            text = data.strip()
            if text:
                self.parts.append(text + " ")

    def text(self) -> str:
        raw = "".join(self.parts)
        raw = re.sub(r"[ \t]+", " ", raw)
        raw = re.sub(r"\n{3,}", "\n\n", raw)
        return raw.strip()


def read_item_property(path: Path, key: str) -> str:
    pattern = re.compile(rf"^:{re.escape(key)}:\s*(.*?)\s*$")
    with path.open(encoding="utf-8") as handle:
        for line in handle:
            match = pattern.match(line)
            if match:
                return match.group(1)
    return ""


def read_item_identifier(path: Path) -> str:
    return (
        read_item_property(path, "ID")
        or path.stem
    )


def replace_property(text: str, key: str, value: str) -> str:
    pattern = re.compile(rf"^:{re.escape(key)}:\s*.*$", re.MULTILINE)
    replacement = f":{key}: {value}"
    if pattern.search(text):
        return pattern.sub(replacement, text, count=1)
    return text


def org_property(value: object) -> str:
    return re.sub(r"\s+", " ", str(value or "")).strip()


def fetch_html(url: str) -> str:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=45) as response:
        raw = response.read()
        encoding = response.headers.get_content_charset() or "utf-8"
    return raw.decode(encoding, errors="replace")


def playwright_readability_page(url: str) -> dict:
    npm = shutil.which("npm")
    if not npm:
        raise RuntimeError("npm executable not found")
    script = Path(__file__).with_name("save-link-readability")
    if not script.exists():
        raise RuntimeError(f"save-link-readability helper not found: {script}")
    with tempfile.TemporaryDirectory(prefix="save-link-readability-") as tmp:
        output_path = Path(tmp) / "article.json"
        command = [npm, "exec", "--yes"]
        for package in READABILITY_PACKAGES:
            command.extend(["--package", package])
        command.extend(
            [
                "--",
                "sh",
                "-c",
                'NODE_PATH="${PATH%%/.bin*}" exec node "$@"',
                "save-link-readability",
                str(script),
                "--url",
                url,
                "--output",
                str(output_path),
            ]
        )
        env = {**os.environ, "npm_config_loglevel": "error"}
        result = subprocess.run(
            command,
            text=True,
            capture_output=True,
            timeout=150,
            check=False,
            env=env,
        )
        if result.returncode != 0:
            message = result.stderr.strip() or result.stdout.strip()
            raise RuntimeError(message or "Playwright Readability extraction failed")
        data = json.loads(output_path.read_text(encoding="utf-8"))
    if not data.get("raw_html"):
        raise RuntimeError("Playwright Readability returned no rendered HTML")
    if not data.get("article_html"):
        raise RuntimeError("Playwright Readability returned no article HTML")
    return data


EWW_READABLE_ELISP = r"""
;;; save-link-eww-readable.el --- Extract readable text -*- lexical-binding: t; -*-
(require 'eww)
(require 'shr)
(require 'subr-x)

(let* ((args (if (string= (car command-line-args-left) "--")
                 (cdr command-line-args-left)
               command-line-args-left))
       (file (nth 0 args))
       (url (nth 1 args))
       (dom (with-temp-buffer
              (insert-file-contents file)
              (eww--parse-html-region (point-min) (point-max))))
       (readable (eww-readable-dom dom)))
  (unless readable
    (error "EWW could not identify a readable article body"))
  (with-temp-buffer
    (let ((shr-width 80)
          (shr-use-fonts nil)
          (shr-use-colors nil)
          (shr-inhibit-images t))
      (shr-insert-document (eww-document-base url readable))
      (let ((text (string-trim (buffer-string))))
        (unless (length> text 0)
          (error "EWW readable extraction produced no text"))
        (princ text)))))
"""


def eww_readable_text(html: str, url: str) -> str:
    emacs = shutil.which("emacs")
    if not emacs:
        raise RuntimeError("emacs executable not found")
    with tempfile.TemporaryDirectory(prefix="save-link-eww-") as tmp:
        tmp_path = Path(tmp)
        html_path = tmp_path / "page.html"
        elisp_path = tmp_path / "eww-readable.el"
        html_path.write_text(html, encoding="utf-8")
        elisp_path.write_text(EWW_READABLE_ELISP, encoding="utf-8")
        result = subprocess.run(
            [emacs, "-Q", "--batch", "-l", str(elisp_path), "--", str(html_path), url],
            text=True,
            capture_output=True,
            timeout=90,
            check=False,
        )
    if result.returncode != 0:
        stderr = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(stderr or "EWW readable extraction failed")
    text = result.stdout.strip()
    if not text:
        raise RuntimeError("EWW readable extraction produced no text")
    return text


def pandoc_html_to_org(html: str) -> str:
    pandoc = shutil.which("pandoc")
    if pandoc:
        result = subprocess.run(
            [pandoc, "-f", "html", "-t", "org"],
            input=html,
            text=True,
            capture_output=True,
            timeout=60,
            check=False,
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    extractor = TextExtractor()
    extractor.feed(html)
    text = extractor.text()
    return text or "Snapshot conversion produced no readable text."


def html_to_org(html: str, url: str, extractor: str) -> tuple[str, str]:
    if extractor in {"auto", "eww"}:
        try:
            return eww_readable_text(html, url), "eww-readable"
        except Exception:
            if extractor == "eww":
                raise
    return pandoc_html_to_org(html), "pandoc"


def readability_to_org(url: str) -> tuple[str, str, str, dict]:
    data = playwright_readability_page(url)
    org_content = pandoc_html_to_org(data["article_html"])
    return data["raw_html"], org_content, "playwright-readability", data


def snapshot_item(root: Path, item_path: Path, mode: str, extractor: str) -> dict:
    item_path = item_path.expanduser()
    url = read_item_property(item_path, "URL")
    org_id = read_item_identifier(item_path)
    if not url:
        raise ValueError(f"{item_path} does not contain a URL property")

    metadata: dict = {}
    if extractor in {"auto", "readability"}:
        try:
            html, org_content, extractor_used, metadata = readability_to_org(url)
        except Exception:
            if extractor == "readability":
                raise
            html = fetch_html(url)
            org_content, extractor_used = html_to_org(html, url, "auto")
    else:
        html = fetch_html(url)
        org_content, extractor_used = html_to_org(html, url, extractor)

    html_path = root / "snapshots" / "html" / f"{org_id}.html"
    html_path.parent.mkdir(parents=True, exist_ok=True)
    html_path.write_text(html, encoding="utf-8")

    readable_path = root / "snapshots" / "readable" / f"{org_id}.org"
    readable_path.parent.mkdir(parents=True, exist_ok=True)
    readable_path.write_text(org_content + "\n", encoding="utf-8")

    marker_begin = "# SAVE-LINK-SNAPSHOT-BEGIN"
    marker_end = "# SAVE-LINK-SNAPSHOT-END"
    fetched = dt.datetime.now().astimezone().strftime("[%Y-%m-%d %a %H:%M]")
    section = (
        f"\n{marker_begin}\n"
        "* Readable Snapshot\n"
        ":PROPERTIES:\n"
        f":FETCHED: {fetched}\n"
        f":HTML_PATH: {html_path}\n"
        f":READABLE_PATH: {readable_path}\n"
        f":SNAPSHOT_MODE: {mode}\n"
        f":SNAPSHOT_EXTRACTOR: {extractor_used}\n"
    )
    optional_properties = (
        ("SNAPSHOT_FINAL_URL", metadata.get("final_url")),
        ("ARTICLE_TITLE", metadata.get("title")),
        ("ARTICLE_BYLINE", metadata.get("byline")),
        ("ARTICLE_SITE_NAME", metadata.get("site_name")),
    )
    for key, value in optional_properties:
        value = org_property(value)
        if value:
            section += f":{key}: {value}\n"
    section += ":END:\n\n" f"{org_content}\n" f"{marker_end}\n"

    item_text = item_path.read_text(encoding="utf-8")
    item_text = replace_property(item_text, "SNAPSHOT_STATUS", "ok")
    if marker_begin in item_text and marker_end in item_text:
        before = item_text.split(marker_begin, 1)[0].rstrip()
        after = item_text.split(marker_end, 1)[1].lstrip()
        item_text = before + section + after
    else:
        item_text = item_text.rstrip() + section
    item_path.write_text(item_text, encoding="utf-8")

    result = {
        "org_id": org_id,
        "item_path": str(item_path),
        "url": url,
        "html_path": str(html_path),
        "readable_path": str(readable_path),
        "mode": mode,
        "extractor": extractor_used,
        "snapshotted_at": iso_timestamp(),
    }
    for key, value in {
        "final_url": metadata.get("final_url"),
        "article_title": metadata.get("title"),
        "article_byline": metadata.get("byline"),
        "article_site_name": metadata.get("site_name"),
    }.items():
        if value:
            result[key] = value
    return result


def queue_matches_item(queue_path: Path, item_path: Path, org_id: str) -> bool:
    try:
        payload = json.loads(queue_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    return payload.get("item_path") == str(item_path) or payload.get("org_id") == org_id


def consume_matching_queue_entries(root: Path, item_path: Path, org_id: str, result: dict) -> list[str]:
    consumed: list[str] = []
    for queue_path in sorted((root / "queue").glob("*.json")):
        if not queue_matches_item(queue_path, item_path, org_id):
            continue
        payload = json.loads(queue_path.read_text(encoding="utf-8"))
        payload["processed_at"] = iso_timestamp()
        payload["processed_by"] = "direct-item-snapshot"
        payload["result"] = result
        processed = root / "logs" / "processed" / f"{queue_path.stem}.json"
        processed.parent.mkdir(parents=True, exist_ok=True)
        processed.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        queue_path.unlink(missing_ok=True)
        consumed.append(str(queue_path))
    return consumed


def snapshot_direct_item(root: Path, item_path: Path, mode: str, extractor: str) -> dict:
    result = snapshot_item(root, item_path, mode, extractor)
    consumed = consume_matching_queue_entries(
        root,
        item_path.expanduser(),
        result["org_id"],
        result,
    )
    if consumed:
        result["queue_consumed"] = consumed
    return result


def process_queue_file(root: Path, queue_path: Path, extractor: str) -> dict:
    payload = json.loads(queue_path.read_text(encoding="utf-8"))
    item_path = Path(payload["item_path"])
    mode = payload.get("archive_mode") or "readable"
    try:
        result = snapshot_item(root, item_path, mode, extractor)
    except Exception as exc:  # noqa: BLE001 - CLI should persist failures.
        failure_dir = root / "failures"
        failure_dir.mkdir(parents=True, exist_ok=True)
        payload["error"] = str(exc)
        payload["failed_at"] = iso_timestamp()
        failure_path = failure_dir / f"{queue_path.stem}.json"
        failure_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        if item_path.exists():
            text = item_path.read_text(encoding="utf-8")
            item_path.write_text(replace_property(text, "SNAPSHOT_STATUS", "failed"), encoding="utf-8")
        queue_path.unlink(missing_ok=True)
        raise

    processed = root / "logs" / "processed" / f"{queue_path.stem}.json"
    processed.parent.mkdir(parents=True, exist_ok=True)
    payload["processed_at"] = iso_timestamp()
    payload["result"] = result
    processed.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    queue_path.unlink(missing_ok=True)
    return result


def refresh_feed(root: Path) -> None:
    script = Path(__file__).with_name("save-link-feed")
    if not script.exists():
        return
    subprocess.run(
        [sys.executable, str(script), "--root", str(root)],
        text=True,
        capture_output=True,
        timeout=30,
        check=False,
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", default="")
    parser.add_argument("--item", action="append", default=[])
    parser.add_argument("--queue-file", default="")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--mode", choices=("readable", "full"), default="readable")
    parser.add_argument("--extractor", choices=("auto", "readability", "eww", "pandoc"), default="auto")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    root = Path(args.root).expanduser() if args.root else default_root()
    results: list[dict] = []

    if args.item:
        for item_path in args.item:
            results.append(snapshot_direct_item(root, Path(item_path), args.mode, args.extractor))
    elif args.queue_file:
        results.append(process_queue_file(root, Path(args.queue_file), args.extractor))
    elif args.all:
        for queue_path in sorted((root / "queue").glob("*.json")):
            results.append(process_queue_file(root, queue_path, args.extractor))
    else:
        parser.error("Provide --item, --queue-file, or --all")

    refresh_feed(root)

    if args.json:
        print(json.dumps(results, ensure_ascii=False, sort_keys=True))
    else:
        for result in results:
            print(f"Snapshotted: {result['item_path']}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, urllib.error.URLError, subprocess.SubprocessError, ValueError, RuntimeError) as error:
        print(f"save-link-snapshot: {error}", file=sys.stderr)
        sys.exit(1)
